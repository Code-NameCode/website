{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/.well-known/ard.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*).md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/web-development",
      "destination": "/websites-and-hosting",
      "permanent": true
    },
    {
      "source": "/hosting",
      "destination": "/websites-and-hosting",
      "permanent": true
    },
    {
      "source": "/web-development.md",
      "destination": "/websites-and-hosting.md",
      "permanent": true
    },
    {
      "source": "/hosting.md",
      "destination": "/websites-and-hosting.md",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/studio",
      "destination": "/studio.html"
    },
    {
      "source": "/home",
      "destination": "/index.html"
    },
    {
      "source": "/websites-and-hosting",
      "destination": "/websites-and-hosting.html"
    },
    {
      "source": "/ai",
      "destination": "/ai.html"
    },
    {
      "source": "/it-and-networks",
      "destination": "/it-and-networks.html"
    },
    {
      "source": "/digital-marketing",
      "destination": "/digital-marketing.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/design-styles",
      "destination": "/design-styles.html"
    },
    {
      "source": "/portfolio",
      "destination": "/portfolio.html"
    },
    {
      "source": "/services",
      "destination": "/services.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/cookie-policy",
      "destination": "/cookie-policy.html"
    }
  ]
}
